{
  "name": "hanzero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "validate:curriculum": "tsx scripts/validateCurriculum.ts",
    "verify:data": "node scripts/verify_curriculum_integrity.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:bundle": "tsx scripts/auditBundle.ts",
    "test:all": "npm run lint && npm run validate:curriculum && npm test && npm run audit:bundle && npm run test:e2e"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.453.0",
    "pinyin-pro": "^3.26.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3"
  }
}
